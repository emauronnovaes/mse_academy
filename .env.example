# Copie este arquivo para ".env" (sem o ".example") e preencha com os dados reais.
# NUNCA suba o arquivo ".env" pro Git/repositório — ele tem senha de banco.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mse_academy
DB_USER=troque_pelo_usuario
DB_PASS=troque_pela_senha

# URL exata do front-end (MSE Academy) que pode chamar essa API.
# Precisa ser EXATA (com https:// e sem barra no final), senão o navegador bloqueia.
ACADEMY_ALLOWED_ORIGIN=https://portal.mseengenharia.com.br

# Chave secreta compartilhada com o Portal MSE, usada pra assinar/validar
# o token de SSO (login automático). Combine essa MESMA chave com quem
# mantém o Portal — sem ela, ninguém consegue logar na Academy.
# Gere uma chave forte, por exemplo: php -r "echo bin2hex(random_bytes(32));"
PORTAL_SSO_SECRET=troque_por_uma_chave_bem_forte_e_aleatoria

# ------------------------------------------------------------
# AWS S3 — de onde os vídeos de treinamento são servidos
# ------------------------------------------------------------
# O bucket deve ser PRIVADO (não público) — o acesso é liberado por URL
# assinada, gerada na hora pela API, só pra quem já passou pelo login da
# Academy e já tem aquele módulo desbloqueado. A URL expira sozinha
# depois de 30 minutos (ver mse_s3_presigned_url em src/AwsS3.php).
#
# Credenciais: crie um usuário IAM específico pra isso (não use a conta
# root da AWS). Política com as 3 permissões que o site usa (ler pra
# gerar link de vídeo, enviar e listar pelo painel de admin):
#   {
#     "Version": "2012-10-17",
#     "Statement": [
#       {
#         "Effect": "Allow",
#         "Action": ["s3:GetObject", "s3:PutObject"],
#         "Resource": "arn:aws:s3:::SEU-BUCKET-AQUI/*"
#       },
#       {
#         "Effect": "Allow",
#         "Action": "s3:ListBucket",
#         "Resource": "arn:aws:s3:::SEU-BUCKET-AQUI"
#       }
#     ]
#   }
AWS_ACCESS_KEY_ID=troque_pela_access_key_do_usuario_iam
AWS_SECRET_ACCESS_KEY=troque_pela_secret_key_do_usuario_iam
AWS_REGION=us-east-1
AWS_S3_BUCKET=troque_pelo_nome_do_bucket

# ------------------------------------------------------------
# API de Ficha Funcional do Hub MSE — usada só como ENRIQUECIMENTO
# opcional no login (busca o cargo/função oficial do RH pelo nome, pra
# melhorar a recomendação de cursos por cargo). NÃO é o que identifica
# quem está logado — quem faz isso é o token assinado do Portal
# (PORTAL_SSO_SECRET, acima). Se essa API falhar ou não achar a pessoa,
# o login continua funcionando normalmente, só sem esse extra.
# ------------------------------------------------------------
PORTAL_FICHA_API_BASE=https://portalmse.com.br/microservices/hub_mse/api_ficha
PORTAL_FICHA_API_TOKEN=troque_pela_chave_gerada_no_hub_mse
